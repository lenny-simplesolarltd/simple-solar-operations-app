{
  "name": "simple-solar-operations-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && npm run format",
    "lint:strict": "eslint --max-warnings=0 src",
    "format": "prettier --write .",
    "format:check": "prettier -c -w .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test:db": "supabase db reset && node scripts/dev-preview-install.mjs && node --test --test-concurrency=1 'tests/*.test.mjs'",
    "test:unit": "vitest run",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "dev:preview:install": "node scripts/dev-preview-install.mjs",
    "test:db:pglite": "node tests/pglite/run.mjs",
    "import:historical-bookings": "jiti scripts/imports/historical-job-bookings/run.ts",
    "import:historical-bookings:docs": "jiti scripts/imports/historical-job-bookings/docs.ts"
  },
  "lint-staged": {
    "**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-accordion": "^1.2.3",
